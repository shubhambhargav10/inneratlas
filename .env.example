# ==============================================================================
# INNERATLAS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brand Information
NEXT_PUBLIC_SITE_NAME="INNERATLAS"
NEXT_PUBLIC_SITE_TAGLINE="Understand yourself beyond the obvious."

# Supabase (PostgreSQL Database & Auth)
# Leave blank to run with local file-backed test storage out of the box
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay Payment Gateway (Test Mode)
# When empty or using mock keys, system provides simulated instant test checkout
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Admin Authentication
ADMIN_SECRET_KEY="inneratlas-admin-secret-key-change-in-prod"

# Optional Email Service (Resend)
RESEND_API_KEY=""
EMAIL_FROM="INNERATLAS <reports@inneratlas.com>"
