# ==============================================================================
# INNERATLAS ENVIRONMENT CONFIGURATION & SECURITY SPECIFICATION
# ==============================================================================

# Application Environment & Base URL
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brand Information (Configurable)
NEXT_PUBLIC_SITE_NAME="INNERATLAS"
NEXT_PUBLIC_SITE_TAGLINE="Understand yourself beyond the obvious."

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay) - Strictly Server-Side Credentials
# ------------------------------------------------------------------------------
# Obtain test credentials from Razorpay Dashboard (Settings > API Keys)
# In production, live credentials must be provided. Missing keys will lock checkout safely.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Development / Testing Simulation Mode
# Set to "true" ONLY in local development to test checkout without active Razorpay keys.
# In production (NODE_ENV="production"), mock payments are strictly rejected by the server.
ENABLE_MOCK_PAYMENTS="true"

# ------------------------------------------------------------------------------
# ADMINISTRATOR AUTHENTICATION
# ------------------------------------------------------------------------------
# Must be a cryptographically random secret string of at least 32 characters.
# Generate with: openssl rand -base64 32
# If unconfigured or empty, all admin routes fail closed (HTTP 500/401).
ADMIN_SECRET_KEY=""

# ------------------------------------------------------------------------------
# DATABASE & PERSISTENCE (Supabase PostgreSQL - Hosted Project: InnerAtlas-dev)
# ------------------------------------------------------------------------------
# In production (NODE_ENV="production"), Supabase PostgreSQL is required.
# In-memory and filesystem fallbacks are strictly prohibited in production.
#
# 1. Project URL:
NEXT_PUBLIC_SUPABASE_URL=""
#
# 2. Publishable Key (safe for client / browser):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
#
# 3. Secret Key (strictly server-side administrative key, NEVER expose to client):
SUPABASE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend - Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="INNERATLAS <reports@inneratlas.com>"
